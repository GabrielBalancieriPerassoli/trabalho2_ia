      "@type": "art:Contribuicao",
      "art:extraidoDe": {
        "@id": "art:artigo_2203_00130v1_secao_3"
      },
      "art:pontuacao": 6,
      "art:texto": {
        "@language": "en",
        "@value": "(2) Paper Plain, an interactive reading interface for research papers that integrates existing affordances like term definition tooltips with novel affordances like in-situ plain language summaries of paper sections and a collection of key questions that guide readers to answering passages in the paper with paired plain language answers (§4)."
      }
    },
