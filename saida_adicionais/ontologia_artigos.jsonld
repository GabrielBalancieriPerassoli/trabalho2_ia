      "art:ordem": 41,
      "art:texto": "Katy I. Gero, Vivian Liu, and Lydia B. Chilton. 2021. Sparks: Inspiration for Science Writing using Language Models. ArXiv abs/2110.07640 (2021)."
    },
    {
      "@id": "art:artigo_2304_02623v1_objetivo_1",
      "@type": "art:Objetivo",
      "art:extraidoDe": {
        "@id": "art:artigo_2304_02623v1_secao_1"
      },
      "art:pontuacao": 5,
      "art:texto": {
        "@language": "en",
        "@value": "In this position paper, we argue that developing AI supports for expository writing has unique and exciting research challenges and can lead to high real-world impacts."
      }
    },
