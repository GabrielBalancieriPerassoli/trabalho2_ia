    {
      "@id": "art:artigo_2203_00130v1_metodo_1",
      "@type": "art:Metodo",
      "art:pontuacao": 5,
      "art:texto": {
        "@language": "en",
        "@value": "To improve access to medical papers, we introduce a novel interactive interface - Paper Plain1 - with four features powered by natural language processing: definitions of unfamiliar terms, in-situ plain language section summaries, a collection of key questions that guide readers to answering passages, and plain language summaries of the answering passages."
      }
    },
    {
