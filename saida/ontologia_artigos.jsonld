      "art:extraidoDe": {
        "@id": "art:artigo_2023_eacl_main_121_secao_6"
      },
      "art:pontuacao": 8,
      "art:texto": {
        "@language": "en",
        "@value": "Designing non-uniform weighing schemes is an interesting direction for future research."
      }
    },
    {
      "@id": "art:artigo_P14_1059_metodo_1",
      "@type": "art:Metodo",
      "art:extraidoDe": {
        "@id": "art:artigo_P14_1059_secao_1"
      },
      "art:pontuacao": 4,
      "art:texto": {
        "@language": "en",
        "@value": "We test this in a monolingual scenario (paraphrase generation) as well as in a cross-lingual setting (translation by synthesizing adjective-noun phrase vectors in English and generating the equivalent expressions in Italian)."
      }
    },
