    },
    {
      "@id": "art:artigo_roark13_objetivo_2",
      "@type": "art:Objetivo",
      "art:extraidoDe": {
        "@id": "art:artigo_roark13_secao_2"
      },
      "art:pontuacao": 5,
      "art:texto": {
        "@language": "en",
        "@value": "We present results under a range of experimental conditions, including: variously adapting the ASR models to the domain; using maximum entropy models rather than CRFs; differing tagsets (BIO versus IO); and with varying degrees of supervision."
      }
    },
