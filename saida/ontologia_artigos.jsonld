      "@id": "art:artigo_bunescu_acl07_trabalho_futuro_2",
      "@type": "art:TrabalhoFuturo",
      "art:extraidoDe": {
        "@id": "art:artigo_bunescu_acl07_secao_9"
      },
      "art:pontuacao": 7,
      "art:texto": {
        "@language": "en",
        "@value": "We are also investigating methods for reducing Type II bias, either by modifying the word weights, or by integrating an appropriate measure of word distribution across positive bags directly in the objective function for the MIL problem."
      }
    },
    {
