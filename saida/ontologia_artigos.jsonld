      },
      "art:pontuacao": 3,
      "art:texto": {
        "@language": "en",
        "@value": "Inspired by the recent success of pretrained Transformer language models across various NLP tasks, we use the Transformer model architecture as basis of encoding the input paper."
      }
    },
