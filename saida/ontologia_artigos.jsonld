      "art:pontuacao": 3,
      "art:texto": {
        "@language": "en",
        "@value": "Because REALM pre-computes language models based on its corpus and does not require any hand-tagged seeds, it is far more scalable than approaches that learn models for each individual relation from hand-tagged data."
      }
