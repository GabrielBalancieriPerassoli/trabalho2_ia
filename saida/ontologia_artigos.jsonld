      "art:titulo": {
        "@language": "en",
        "@value": "Identifying Relations for Open Information Extraction"
      },
      "rdfs:label": "Identifying Relations for Open Information Extraction"
    },
    {
      "@id": "art:artigo_P14_1059_metodo_2",
      "@type": "art:Metodo",
      "art:extraidoDe": {
        "@id": "art:artigo_P14_1059_secao_2"
      },
      "art:pontuacao": 7,
      "art:texto": {
        "@language": "en",
        "@value": "In short, we revert the composition process and we propose a framework of data-induced, syntax-dependent functions that decompose a single vector into a vector sequence."
      }
    },
    {
      "@id": "art:artigo_roark13_metodo_3",
      "@type": "art:Metodo",
      "art:extraidoDe": {
        "@id": "art:artigo_roark13_secao_2"
      },
      "art:pontuacao": 4,
      "art:texto": {
        "@language": "en",
        "@value": "The approach is general enough to allow tagging of word confusion networks derived from lattices, thus allowing us to explore the utility of such representations to achieve robustness."
      }
    },
