      },
      "art:pontuacao": 5,
      "art:texto": {
        "@language": "en",
        "@value": "We deploy local features for SCFG-based SMT that can be read off from rules at runtime, and present a learning algorithm that applies l1/l2 regularization for joint feature selection over distributed stochastic learning processes."
      }
    },
    {
