        "@id": "art:artigo_fader11_secao_2"
      },
      "art:pontuacao": 5,
      "art:texto": {
        "@language": "en",
        "@value": "For example, consider the sentence \"Faust made a deal with the devil.\" Previous Open IE systems return the uninformative (Faust, made, a deal) instead of (Faust, made a deal with, the devil)."
