    {
      "@id": "art:artigo_2023_eacl_main_121_metodo_3",
      "@type": "art:Metodo",
      "art:extraidoDe": {
        "@id": "art:artigo_2023_eacl_main_121_secao_2"
      },
      "art:pontuacao": 6,
      "art:texto": {
        "@language": "en",
        "@value": "We empirically evaluate LONG EVAL using human annotation studies on two long-form summarization datasets: SQuALITY (Wang et al., 2022) and PubMed (Cohan et al., 2018)."
      }
    },
    {
      "@id": "art:autor_Arman_Cohan",
      "@type": "art:Autor",
      "art:nome": "Arman Cohan"
    },
    {
      "@id": "art:artigo_2023_eacl_main_121_trabalho_futuro_2",
