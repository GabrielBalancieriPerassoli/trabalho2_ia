      },
      "art:pontuacao": 5,
      "art:texto": {
        "@language": "en",
        "@value": "We describe methods used in a scalable deployed production system for extracting structured information from scientific documents into the literature graph (see Fig. 1)."
      }
    },
    {
      "@id": "art:artigo_2020_acl_main_207_metodo_3",
      "@type": "art:Metodo",
      "art:extraidoDe": {
