@prefix art: <http://www.din.uem.br/iia/artigo#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.din.uem.br/iia/artigo> a owl:Ontology ;
    rdfs:label "Ontologia de Artigo Científico"@pt ;
    rdfs:comment "Estrutura de um artigo científico: metadados, seções, elementos retóricos (objetivo, problema, método, contribuição, trabalho futuro), referências e termos."@pt ;
    rdfs:seeAlso <http://purl.org/spar/deo>,
        <http://purl.org/spar/doco>,
        <http://purl.org/spar/fabio> ;
    owl:versionInfo "1.0" .

art:ano a owl:DatatypeProperty ;
    rdfs:range xsd:gYear .

art:anoReferencia a owl:DatatypeProperty ;
    rdfs:domain art:Referencia ;
    rdfs:range xsd:gYear .

art:baseDados a owl:DatatypeProperty ;
    rdfs:domain art:Corpus ;
    rdfs:range xsd:string .

art:citaReferencia a owl:ObjectProperty ;
    rdfs:domain art:ArtigoCientifico ;
    rdfs:range art:Referencia .

art:corpus_artigos a art:Corpus ;
    art:baseDados "IEEE Xplore" ;
    art:temArtigo art:artigo_2020_acl_main_207,
        art:artigo_2020_acl_main_447,
        art:artigo_2023_eacl_main_121,
        art:artigo_N18_3011,
        art:artigo_P07_1088,
        art:artigo_P14_1059,
        art:artigo_bohnet09,
        art:artigo_bunescu_acl07,
        art:artigo_dyer12,
        art:artigo_fader11,
        art:artigo_mooney05,
        art:artigo_roark13 ;
    art:tema "Processamento de Linguagem Natural"@pt .

art:doTermo a owl:ObjectProperty ;
    rdfs:domain art:OcorrenciaTermo ;
    rdfs:range art:Termo .

art:entreArtigos a owl:ObjectProperty ;
    rdfs:domain art:Similaridade ;
    rdfs:range art:ArtigoCientifico .

art:extraidoDe a owl:ObjectProperty ;
    rdfs:comment "Seção de onde o trecho foi extraído."@pt ;
    rdfs:domain art:ElementoRetorico ;
    rdfs:range art:Secao .

art:frequencia a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

art:lema a owl:DatatypeProperty ;
    rdfs:domain art:Termo ;
    rdfs:range xsd:string .

art:mencionaTarefa a owl:ObjectProperty ;
    rdfs:domain art:ArtigoCientifico ;
    rdfs:range art:Mencao .

art:mencionaTecnica a owl:ObjectProperty ;
    rdfs:domain art:ArtigoCientifico ;
    rdfs:range art:Mencao .

art:nome a owl:DatatypeProperty ;
    rdfs:domain art:Autor ;
    rdfs:range xsd:string .

art:nomeArquivo a owl:DatatypeProperty ;
    rdfs:range xsd:string .

art:numeroPaginas a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

art:numeroPalavras a owl:DatatypeProperty ;
    rdfs:domain art:Secao ;
    rdfs:range xsd:integer .

art:numeroReferencias a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

art:ordem a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

art:pontuacao a owl:DatatypeProperty ;
    rdfs:comment "Pontuação dada pelas regras de extração (confiança)."@pt ;
    rdfs:domain art:ElementoRetorico ;
    rdfs:range xsd:integer .

art:posicaoRanking a owl:DatatypeProperty ;
    rdfs:domain art:OcorrenciaTermo ;
    rdfs:range xsd:integer .

art:radical a owl:DatatypeProperty ;
    rdfs:domain art:Termo ;
    rdfs:range xsd:string .

art:refereSe a owl:ObjectProperty ;
    rdfs:domain art:Mencao ;
    rdfs:range art:Termo .

