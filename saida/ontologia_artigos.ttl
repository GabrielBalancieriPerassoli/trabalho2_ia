art:similarA a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Os dois artigos têm similaridade TF-IDF acima do limiar."@pt ;
    rdfs:domain art:ArtigoCientifico ;
    rdfs:range art:ArtigoCientifico .

art:temArtigo a owl:ObjectProperty ;
    rdfs:domain art:Corpus ;
    rdfs:range art:ArtigoCientifico .

art:temAutor a owl:ObjectProperty ;
    rdfs:domain art:ArtigoCientifico ;
    rdfs:range art:Autor .

art:temContribuicao a owl:ObjectProperty ;
    rdfs:range art:Contribuicao ;
    rdfs:subPropertyOf art:temElemento .

art:temMetodo a owl:ObjectProperty ;
    rdfs:range art:Metodo ;
    rdfs:subPropertyOf art:temElemento .

art:temObjetivo a owl:ObjectProperty ;
    rdfs:range art:Objetivo ;
    rdfs:subPropertyOf art:temElemento .

art:temOcorrencia a owl:ObjectProperty ;
    rdfs:domain art:ArtigoCientifico ;
    rdfs:range art:OcorrenciaTermo .

art:temProblema a owl:ObjectProperty ;
    rdfs:range art:Problema ;
    rdfs:subPropertyOf art:temElemento .

art:temSecao a owl:ObjectProperty ;
    rdfs:domain art:ArtigoCientifico ;
    rdfs:range art:Secao .

art:temTrabalhoFuturo a owl:ObjectProperty ;
    rdfs:range art:TrabalhoFuturo ;
    rdfs:subPropertyOf art:temElemento .

art:tema a owl:DatatypeProperty ;
    rdfs:domain art:Corpus ;
    rdfs:range xsd:string .

art:texto a owl:DatatypeProperty ;
    rdfs:comment "Texto do trecho extraído ou da referência."@pt ;
    rdfs:range xsd:string .

art:titulo a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:title .

art:tituloSecao a owl:DatatypeProperty ;
    rdfs:domain art:Secao ;
    rdfs:range xsd:string .

art:valor a owl:DatatypeProperty ;
    rdfs:domain art:Similaridade ;
    rdfs:range xsd:decimal .

art:artigo_2020_acl_main_207_contribuicao_1 a art:Contribuicao ;
    art:extraidoDe art:artigo_2020_acl_main_207_secao_2 ;
    art:pontuacao 5 ;
    art:texto "As an additional contribution of this work, we introduce and release SCIDOCS 3 , a novel collection of data sets and an evaluation suite for document-level embeddings in the scientific domain."@en .

art:artigo_2020_acl_main_207_metodo_1 a art:Metodo ;
    art:extraidoDe art:artigo_2020_acl_main_207_secao_2 ;
    art:pontuacao 4 ;
    art:texto "We specifically use citations as a naturally occurring, inter-document incidental supervision signal indicating which documents are most related and formulate the signal into a triplet-loss pretraining objective."@en .

art:artigo_2020_acl_main_207_metodo_2 a art:Metodo ;
    art:extraidoDe art:artigo_2020_acl_main_207_secao_2 ;
    art:pontuacao 3 ;
    art:texto "In experiments, we show that SPECTER 's representations substantially outperform the state- 2SPECTER : Scientific Paper Embeddings using Citation-informed TransformERs of-the-art on a variety of document-level tasks, including topic classification, citation prediction, and recommendation."@en .

art:artigo_2020_acl_main_207_metodo_3 a art:Metodo ;
    art:extraidoDe art:artigo_2020_acl_main_207_secao_3 ;
    art:pontuacao 3 ;
    art:texto "Inspired by the recent success of pretrained Transformer language models across various NLP tasks, we use the Transformer model architecture as basis of encoding the input paper."@en .

art:artigo_2020_acl_main_207_objetivo_1 a art:Objetivo ;
    art:extraidoDe art:artigo_2020_acl_main_207_secao_1 ;
    art:pontuacao 5 ;
    art:texto "We propose SPECTER , a new method to generate document-level embedding of scientific documents based on pretraining a Transformer language model on a powerful signal of document-level relatedness: the citation graph."@en .

art:artigo_2020_acl_main_207_objetivo_2 a art:Objetivo ;
    art:extraidoDe art:artigo_2020_acl_main_207_secao_2 ;
    art:pontuacao 5 ;
    art:texto "Here, we study how to leverage the power of pretrained language models to learn embeddings for scientific documents."@en .

art:artigo_2020_acl_main_207_problema_1 a art:Problema ;
    art:extraidoDe art:artigo_2020_acl_main_207_secao_1 ;
    art:pontuacao 7 ;
    art:texto "Recent Transformer language models like BERT learn powerful textual representations, but these models are targeted towards token- and sentence-level training objectives and do not leverage information on inter-document relatedness, which limits their document-level representation power."@en .

art:artigo_2020_acl_main_207_problema_2 a art:Problema ;
    art:extraidoDe art:artigo_2020_acl_main_207_secao_2 ;
    art:pontuacao 7 ;
    art:texto "While such models are widely used for representing individual words ∗ Equal contribution 1 https://github.com/allenai/specter or sentences, extensions to whole-document embeddings are relatively underexplored."@en .

art:artigo_2020_acl_main_207_ref_1 a art:Referencia ;
    art:anoReferencia "2019"^^xsd:gYear ;
    art:ordem 1 ;
    art:texto "Anant K. Agarwal, Ivan Zaitsev, Xuanhui Wang, Cheng Yen Li, Marc Najork, and Thorsten Joachims. 2019. Estimating position bias without intrusive interventions. In WSDM." .

art:artigo_2020_acl_main_207_ref_10 a art:Referencia ;
    art:anoReferencia "2010"^^xsd:gYear ;
    art:ordem 10 ;
    art:texto "K. Bretonnel Cohen, Helen L. Johnson, Karin M. Verspoor, Christophe Roeder, and Lawrence Hunter. 2010. The structural and content aspects of abstracts versus bodies of full text journal articles are different. BMC Bioinformatics, 11:492-492." .

art:artigo_2020_acl_main_207_ref_11 a art:Referencia ;
